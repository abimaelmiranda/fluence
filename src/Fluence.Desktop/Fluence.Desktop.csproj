<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>Fluence</AssemblyName>
    <AssemblyTitle>Fluence IDE</AssemblyTitle>
    <Product>Fluence IDE</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\fluence.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
    <PackageReference Include="Semi.Avalonia" Version="12.0.3" />
    <PackageReference Include="Serilog" Version="4.3.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fluence.Core\Fluence.Core.csproj" />
    <ProjectReference Include="..\Fluence.Infrastructure\Fluence.Infrastructure.csproj" />
    <ProjectReference Include="..\..\modules\Fluence.Modules.Settings\Fluence.Modules.Settings.csproj" />
    <ProjectReference Include="..\..\modules\Fluence.Modules.Workbench\Fluence.Modules.Workbench.csproj" />
    <ProjectReference Include="..\..\modules\Fluence.Modules.NuGetExplorer\Fluence.Modules.NuGetExplorer.csproj" />
    <ProjectReference Include="..\..\modules\Fluence.Modules.Terminal\Fluence.Modules.Terminal.csproj" />
    <ProjectReference Include="..\..\modules\Fluence.Modules.Toolchains\Fluence.Modules.Toolchains.csproj" />
    <ProjectReference Include="..\..\modules\Fluence.Modules.SourceControl\Fluence.Modules.SourceControl.csproj" />
  </ItemGroup>
</Project>
