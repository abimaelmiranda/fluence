<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>Fluence</AssemblyName>
    <AssemblyTitle>Fluence IDE</AssemblyTitle>
    <Product>Fluence IDE</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\fluence.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <PropertyGroup>
    <NetcoredbgSourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../tools/netcoredbg'))</NetcoredbgSourceRoot>
  </PropertyGroup>
  <Target Name="CopyNetcoredbgTools" AfterTargets="Build">
    <ItemGroup>
      <NetcoredbgTools Include="$(NetcoredbgSourceRoot)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(NetcoredbgTools)" DestinationFiles="@(NetcoredbgTools-&gt;'$(OutDir)tools/netcoredbg/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
    <PackageReference Include="Semi.Avalonia" Version="12.0.3" />
    <PackageReference Include="Serilog" Version="4.3.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fluence.Core\Fluence.Core.csproj" />
    <ProjectReference Include="..\Fluence.Infrastructure\Fluence.Infrastructure.csproj" />
    <ProjectReference Include="..\..\modules\Fluence.Modules.Settings\Fluence.Modules.Settings.csproj" />
    <ProjectReference Include="..\..\modules\Fluence.Modules.FileExplorer\Fluence.Modules.FileExplorer.csproj" />
    <ProjectReference Include="..\..\modules\Fluence.Modules.NuGetExplorer\Fluence.Modules.NuGetExplorer.csproj" />
    <ProjectReference Include="..\..\modules\Fluence.Modules.SolutionView\Fluence.Modules.SolutionView.csproj" />
    <ProjectReference Include="..\..\modules\Fluence.Modules.Editor\Fluence.Modules.Editor.csproj" />
    <ProjectReference Include="..\..\modules\Fluence.Modules.Terminal\Fluence.Modules.Terminal.csproj" />
    <ProjectReference Include="..\..\modules\Fluence.Modules.DotnetCli\Fluence.Modules.DotnetCli.csproj" />
    <ProjectReference Include="..\..\modules\Fluence.Modules.Debug\Fluence.Modules.Debug.csproj" />
    <ProjectReference Include="..\..\modules\Fluence.Modules.DebuggerSetup\Fluence.Modules.DebuggerSetup.csproj" />
    <ProjectReference Include="..\..\modules\Fluence.Modules.SourceControl\Fluence.Modules.SourceControl.csproj" />
    <ProjectReference Include="..\..\modules\Fluence.Modules.LspSetup\Fluence.Modules.LspSetup.csproj" />
    <ProjectReference Include="..\..\modules\Fluence.Modules.LanguageServer\Fluence.Modules.LanguageServer.csproj" />
  </ItemGroup>
</Project>
