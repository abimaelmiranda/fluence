<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="FluenceFontSizeSmall">12</x:Double>
    <x:Double x:Key="FluenceFontSizeBody">14</x:Double>
    <x:Double x:Key="FluenceFontSizeTitle">18</x:Double>
    <x:Double x:Key="FluenceFontSizeDisplay">28</x:Double>
    <FontFamily x:Key="FluenceFontFamily">Inter, Segoe UI, SF Pro Text</FontFamily>
</ResourceDictionary>
