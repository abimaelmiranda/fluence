<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fluence.Desktop.ViewModels"
             x:Class="Fluence.Desktop.Views.WelcomeView"
             x:DataType="vm:WelcomeViewModel">
    <Grid RowDefinitions="*,Auto,*" ColumnDefinitions="*,420,*">
        <StackPanel Grid.Row="1"
                    Grid.Column="1"
                    Spacing="18"
                    HorizontalAlignment="Stretch">
            <TextBlock Text="Fluence IDE"
                       FontFamily="{StaticResource FluenceFontFamily}"
                       FontSize="{StaticResource FluenceFontSizeDisplay}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource FluenceBrushTextPrimary}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Start a focused C# workspace"
                       FontFamily="{StaticResource FluenceFontFamily}"
                       FontSize="{StaticResource FluenceFontSizeBody}"
                       Foreground="{StaticResource FluenceBrushTextSecondary}"
                       HorizontalAlignment="Center"/>

            <StackPanel Spacing="10" Margin="0,10,0,0">
                <Button Content="Open File"
                        Command="{Binding OpenFileCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                <Button Content="Open Folder"
                        Command="{Binding OpenFolderCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                <Button Content="Open Solution"
                        Command="{Binding OpenSolutionCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="{Binding Status}"
                       FontFamily="{StaticResource FluenceFontFamily}"
                       FontSize="{StaticResource FluenceFontSizeSmall}"
                       Foreground="{StaticResource FluenceBrushTextSecondary}"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
