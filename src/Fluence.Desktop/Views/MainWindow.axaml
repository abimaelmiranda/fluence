<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fluence.Desktop.ViewModels"
        xmlns:views="using:Fluence.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="Fluence.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Fluence IDE"
        MinWidth="920"
        MinHeight="620"
        Background="{StaticResource FluenceBrushShell}"
        xmlns:converters="using:Fluence.Desktop.Converters">

    <Design.DataContext>
    </Design.DataContext>

    <Panel>
    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
            <Border Grid.Column="0"
                    Background="{StaticResource FluenceBrushShell}"
                    BorderBrush="{StaticResource FluenceBrushBorder}"
                    BorderThickness="0,0,1,0">
                <ContentControl Content="{Binding Welcome}"
                                IsVisible="{Binding IsWelcomeVisible}"/>
            </Border>

            <Border Grid.Column="0"
                    Background="{StaticResource FluenceBrushShell}"
                    IsVisible="{Binding IsWorkspaceVisible}">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Height="38"
                            Background="{StaticResource FluenceBrushSurface}"
                            BorderBrush="{StaticResource FluenceBrushBorder}"
                            BorderThickness="0,0,0,1"
                            IsVisible="{Binding IsWorkspaceVisible}">
                        <Grid ColumnDefinitions="*,Auto">
                            <ScrollViewer Grid.Column="0"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding OpenDocuments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DocumentTabViewModel">
                                            <Border MinWidth="160"
                                                    MaxWidth="260"
                                                    Height="38"
                                                    Padding="6,0,8,0"
                                                    Background="{StaticResource FluenceBrushShell}"
                                                    BorderBrush="{StaticResource FluenceBrushBorder}"
                                                    BorderThickness="0,0,1,0">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                    <Button Grid.Column="0"
                                                            Command="{Binding ActivateCommand}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="8,0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            ToolTip.Tip="{Binding Path}">
                                                        <TextBlock Text="{Binding DisplayTitle}"
                                                                   FontFamily="{StaticResource FluenceFontFamily}"
                                                                   FontSize="{StaticResource FluenceFontSizeSmall}"
                                                                   Foreground="{StaticResource FluenceBrushTextPrimary}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                    </Button>
                                                    <Button Grid.Column="1"
                                                            Content="X"
                                                            Command="{Binding CloseCommand}"
                                                            Width="24"
                                                            Height="24"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="{StaticResource FluenceBrushTextSecondary}"
                                                            FontFamily="{StaticResource FluenceFontFamily}"
                                                            FontSize="{StaticResource FluenceFontSizeSmall}"
                                                            ToolTip.Tip="Close tab"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Margin="8,0"
                                        Spacing="4"
                                        VerticalAlignment="Center">
                                <Button Content="Run"
                                        Command="{Binding RunCommand}"
                                        Height="26"
                                        MinWidth="58"
                                        Padding="10,0"
                                        FontFamily="{StaticResource FluenceFontFamily}"
                                        FontSize="{StaticResource FluenceFontSizeSmall}"
                                        ToolTip.Tip="Run"/>
                                <Button Content="Debug"
                                        Command="{Binding DebugCommand}"
                                        Height="26"
                                        MinWidth="66"
                                        Padding="10,0"
                                        FontFamily="{StaticResource FluenceFontFamily}"
                                        FontSize="{StaticResource FluenceFontSizeSmall}"
                                        ToolTip.Tip="Debug"/>
                                <Button Content="Stop"
                                        Command="{Binding StopDebugCommand}"
                                        IsVisible="{Binding IsDebugging}"
                                        Height="26"
                                        MinWidth="56"
                                        Padding="10,0"
                                        FontFamily="{StaticResource FluenceFontFamily}"
                                        FontSize="{StaticResource FluenceFontSizeSmall}"
                                        ToolTip.Tip="Stop debug"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ContentControl Content="{Binding MainEditorContent}"
                                        IsVisible="{Binding HasActiveDocument}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"/>
                        <TextBlock Text="{Binding EditorPlaceholder}"
                                   IsVisible="{Binding HasNoActiveDocument}"
                                   FontFamily="{StaticResource FluenceFontFamily}"
                                   FontSize="{StaticResource FluenceFontSizeTitle}"
                                   Foreground="{StaticResource FluenceBrushTextSecondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Width="{Binding SidebarWidth}"
                    Background="{StaticResource FluenceBrushSurface}"
                    BorderBrush="{StaticResource FluenceBrushBorder}"
                    BorderThickness="1,0,0,0"
                    IsVisible="{Binding IsSidebarVisible}">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Padding="12,8"
                            BorderBrush="{StaticResource FluenceBrushBorder}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding SidebarTitle}"
                                   FontFamily="{StaticResource FluenceFontFamily}"
                                   FontSize="{StaticResource FluenceFontSizeSmall}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource FluenceBrushTextSecondary}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ContentControl Content="{Binding ActiveSidebarContent}"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ActivityBar — fixed 48px strip on the far right -->
            <Border Grid.Column="2"
                    Width="48"
                    Background="{StaticResource FluenceBrushActivityBarBackground}"
                    BorderBrush="{StaticResource FluenceBrushBorder}"
                    BorderThickness="1,0,0,0"
                    IsVisible="{Binding IsWorkspaceVisible}">
                <StackPanel Spacing="4" Margin="0,8">

                    <!-- Files -->
                    <Button Command="{Binding ActivityBar.SelectTabCommand}"
                            CommandParameter="Files"
                            Width="40" Height="40" Padding="0"
                            HorizontalAlignment="Center"
                            Background="{Binding ActivityBar.ActiveTabId,
                                Converter={StaticResource ActivityBarBgConverter},
                                ConverterParameter=Files}"
                            BorderThickness="0"
                            CornerRadius="6"
                            ToolTip.Tip="Files">
                        <PathIcon Width="20" Height="20"
                                  Foreground="{Binding ActivityBar.ActiveTabId,
                                      Converter={StaticResource ActivityBarFgConverter},
                                      ConverterParameter=Files}"
                                  Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/>
                    </Button>

                    <!-- Source Control -->
                    <Button Command="{Binding ActivityBar.SelectTabCommand}"
                            CommandParameter="SourceControl"
                            Width="40" Height="40" Padding="0"
                            HorizontalAlignment="Center"
                            Background="{Binding ActivityBar.ActiveTabId,
                                Converter={StaticResource ActivityBarBgConverter},
                                ConverterParameter=SourceControl}"
                            BorderThickness="0"
                            CornerRadius="6"
                            ToolTip.Tip="Source Control">
                        <PathIcon Width="20" Height="20"
                                  Foreground="{Binding ActivityBar.ActiveTabId,
                                      Converter={StaticResource ActivityBarFgConverter},
                                      ConverterParameter=SourceControl}"
                                  Data="M9.5 3.25a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.493 2.493 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25z"/>
                    </Button>

                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource FluenceBrushBottomBarBackground}"
                BorderBrush="{StaticResource FluenceBrushBorder}"
                BorderThickness="0,1,0,0">
            <StackPanel>
                <Border x:Name="TerminalResizeHandle"
                        Height="6"
                        Background="Transparent"
                        Cursor="SizeNorthSouth"
                        PointerPressed="OnTerminalResizeHandlePointerPressed"
                        PointerMoved="OnTerminalResizeHandlePointerMoved"
                        PointerReleased="OnTerminalResizeHandlePointerReleased"
                        PointerCaptureLost="OnTerminalResizeHandlePointerCaptureLost">
                    <Border Height="1"
                            VerticalAlignment="Top"
                            Background="{StaticResource FluenceBrushBorder}"
                            Opacity="0.65"/>
                </Border>

                <Border Height="26"
                        Background="Transparent"
                        PointerReleased="OnTerminalToggleHandlePointerReleased">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding BottomBarTitle}"
                                   Margin="12,0"
                                   FontFamily="{StaticResource FluenceFontFamily}"
                                   FontSize="{StaticResource FluenceFontSizeSmall}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource FluenceBrushTextPrimary}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsSemanticTokensLoading}">
                            <TextBlock Text="{Binding SemanticTokensStatusText}"
                                       FontFamily="{StaticResource FluenceFontFamily}"
                                       FontSize="{StaticResource FluenceFontSizeSmall}"
                                       Foreground="{StaticResource FluenceBrushTextSecondary}"
                                       VerticalAlignment="Center"/>
                            <ProgressBar IsIndeterminate="True"
                                         Width="120"
                                         Height="3"
                                         Foreground="{StaticResource FluenceBrushAccent}"
                                         VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Height="{Binding TerminalHeight}"
                        IsVisible="{Binding IsTerminalExpanded}">
                    <ContentControl Content="{Binding TerminalContent}"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>

    <!-- Saving workspace overlay -->
    <Border IsVisible="{Binding IsSavingWorkspace}"
            Background="#BB000000">
        <Border Background="{StaticResource FluenceBrushSurface}"
                BorderBrush="{StaticResource FluenceBrushBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="32,24"
                Width="280"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <TextBlock Text="Saving workspace..."
                           FontFamily="{StaticResource FluenceFontFamily}"
                           FontSize="{StaticResource FluenceFontSizeBody}"
                           Foreground="{StaticResource FluenceBrushTextPrimary}"
                           HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True"
                             Height="3"
                             Foreground="{StaticResource FluenceBrushAccent}"
                             HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>
    </Border>

    </Panel>

</Window>
