<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Fluence.Desktop.Views.AboutDialog"
        Title="About Fluence"
        Icon="/Assets/fluence.ico"
        Width="380"
        Height="260"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource FluenceBrushShell}">
    <Grid RowDefinitions="*,Auto" Margin="32">
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="6">
            <Image Source="/Assets/fluence.ico"
                   Width="64"
                   Height="64"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>
            <TextBlock Text="Fluence"
                       FontFamily="{StaticResource FluenceFontFamily}"
                       FontSize="{StaticResource FluenceFontSizeDisplay}"
                       FontWeight="Bold"
                       Foreground="{StaticResource FluenceBrushTextPrimary}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Open source IDE for C# development"
                       FontFamily="{StaticResource FluenceFontFamily}"
                       FontSize="{StaticResource FluenceFontSizeBody}"
                       Foreground="{StaticResource FluenceBrushTextSecondary}"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="VersionText"
                       FontFamily="{StaticResource FluenceFontFamily}"
                       FontSize="{StaticResource FluenceFontSizeSmall}"
                       Foreground="{StaticResource FluenceBrushTextSecondary}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <Button Grid.Row="1"
                Content="Close"
                Click="OnCloseClicked"
                HorizontalAlignment="Center"
                MinWidth="96"/>
    </Grid>
</Window>
