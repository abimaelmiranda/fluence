<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:vm="using:Fluence.Desktop.ViewModels"
             x:Class="Fluence.Desktop.Views.EditorView"
             x:DataType="vm:EditorViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <avaloniaEdit:TextEditor x:Name="Editor"
                             ShowLineNumbers="True"
                             FontFamily="Menlo,Consolas,Cascadia Mono,monospace"
                             FontSize="13"
                             Background="{StaticResource FluenceBrushShell}"
                             Foreground="{StaticResource FluenceBrushTextPrimary}"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"/>
</UserControl>
