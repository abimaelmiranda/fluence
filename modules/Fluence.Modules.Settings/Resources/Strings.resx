  <!-- Property descriptions -->
  <data name="Settings.Description.global.FontFamily" xml:space="preserve">
    <value>Controls the default UI font family used by the IDE.</value>
  </data>
  <data name="Settings.Description.global.FontSize" xml:space="preserve">
    <value>Controls the default UI font size in pixels.</value>
  </data>
  <data name="Settings.Description.global.Theme" xml:space="preserve">
    <value>Selects the active application theme.</value>
  </data>
  <data name="Settings.Description.editor.FontFamily" xml:space="preserve">
    <value>Controls the font family used in the code editor.</value>
  </data>
  <data name="Settings.Description.editor.FontSize" xml:space="preserve">
    <value>Controls the editor font size in pixels.</value>
  </data>
  <data name="Settings.Description.editor.LineHeightFactor" xml:space="preserve">
    <value>Controls editor line spacing as a multiplier of the font size.</value>
  </data>
  <data name="Settings.Description.editor.ShowLineNumbers" xml:space="preserve">
    <value>Shows line numbers in editor gutters.</value>
  </data>
  <data name="Settings.Description.editor.AutoPairBrackets" xml:space="preserve">
    <value>Automatically inserts the matching bracket while typing.</value>
  </data>
  <data name="Settings.Description.editor.FormatOnSave" xml:space="preserve">
    <value>Formats files when they are saved, when a formatter is available.</value>
  </data>
  <data name="Settings.Description.editor.CompletionTriggerDelayMs" xml:space="preserve">
    <value>Controls the delay before completion suggestions are requested.</value>
  </data>
  <data name="Settings.Description.languageServer.SuppressedDiagnosticCodes" xml:space="preserve">
    <value>Suppresses Roslyn or OmniSharp diagnostic IDs and related code actions.</value>
  </data>
  <data name="Settings.Description.languageServer.EnableMsBuild" xml:space="preserve">
    <value>Enables MSBuild project loading in OmniSharp.</value>
  </data>
  <data name="Settings.Description.languageServer.LoadProjectsOnDemand" xml:space="preserve">
    <value>Loads projects only when they are needed by the language server.</value>
  </data>
  <data name="Settings.Description.languageServer.EnablePackageAutoRestore" xml:space="preserve">
    <value>Allows OmniSharp to restore missing packages automatically.</value>
  </data>
  <data name="Settings.Description.languageServer.EnableAnalyzersSupport" xml:space="preserve">
    <value>Enables analyzer diagnostics and code fixes from Roslyn analyzers.</value>
  </data>
  <data name="Settings.Description.languageServer.EnableDecompilationSupport" xml:space="preserve">
    <value>Allows navigation into decompiled symbols when source is unavailable.</value>
  </data>
  <data name="Settings.Description.languageServer.EnableImportCompletion" xml:space="preserve">
    <value>Includes import suggestions in completion results.</value>
  </data>
  <data name="Settings.Description.languageServer.DiagnosticWorkersThreadCount" xml:space="preserve">
    <value>Controls how many workers OmniSharp uses for diagnostics.</value>
  </data>
  <data name="Settings.Description.languageServer.EnableEditorConfigSupport" xml:space="preserve">
    <value>Applies .editorconfig formatting and analyzer preferences.</value>
  </data>
  <data name="Settings.Description.languageServer.IncludePrereleases" xml:space="preserve">
    <value>Allows prerelease SDKs when resolving the language server SDK.</value>
  </data>
  <data name="Settings.Description.shell.SidebarWidth" xml:space="preserve">
    <value>Controls the default width of the left sidebar.</value>
  </data>
  <data name="Settings.Description.shell.TerminalHeight" xml:space="preserve">
    <value>Controls the default height of the bottom terminal panel.</value>
  </data>
  <data name="Settings.Description.shell.AnimationsEnabled" xml:space="preserve">
