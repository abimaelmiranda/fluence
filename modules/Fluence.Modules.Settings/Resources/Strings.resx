  </data>
  <data name="Settings.Description.problems.ShowWarningsFromAllFiles" xml:space="preserve">
    <value>Shows warning diagnostics from files that are not currently open.</value>
  </data>
  <data name="Settings.Description.problems.ShowInformationFromAllFiles" xml:space="preserve">
    <value>Shows informational diagnostics from files that are not currently open.</value>
  </data>
  <data name="Settings.Description.problems.MaxVisibleProblems" xml:space="preserve">
    <value>Limits the number of problems shown in the Problems panel.</value>
  </data>
  <data name="Settings.Description.debug.ExceptionBreakMode" xml:space="preserve">
    <value>Controls when the debugger stops on exceptions.</value>
  </data>
  <data name="Settings.Description.sourceControl.RefreshIntervalSeconds" xml:space="preserve">
    <value>Controls how often Source Control refreshes Git status while a workspace is open. Minimum: 5 seconds.</value>
  </data>
  <data name="Settings.Description.diagnostics.EnableMemoryMonitor" xml:space="preserve">
