<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fluence.Modules.Settings.ViewModels"
             xmlns:theming="using:Fluence.Core.Models.Theming"
             x:Class="Fluence.Modules.Settings.Views.SettingsToolView"
             x:DataType="vm:SettingsToolViewModel">
    <Grid RowDefinitions="Auto,*"
          Background="{StaticResource FluenceBrushShell}">
        <Border Grid.Row="0"
                Padding="12,8"
                Background="{StaticResource FluenceBrushSurface}"
                BorderBrush="{StaticResource FluenceBrushBorder}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        Content="Restore defaults"
                        Command="{Binding RestoreDefaultsCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource FluenceBrushTextSecondary}"
                        FontFamily="{StaticResource FluenceFontFamily}"
                        FontSize="{StaticResource FluenceFontSizeSmall}"
                        Padding="4,0"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Status}"
                           Margin="12,0"
                           FontFamily="{StaticResource FluenceFontFamily}"
                           FontSize="{StaticResource FluenceFontSizeSmall}"
                           Foreground="{StaticResource FluenceBrushTextSecondary}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button Content="Install theme"
                            Command="{Binding InstallThemeCommand}"/>
                    <Button Content="Save and apply"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Settings">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sections}"
                                  Margin="18">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingsSectionViewModel">
                                <StackPanel Spacing="8"
                                            Margin="0,0,0,22">
                                    <TextBlock Text="{Binding Name}"
                                               FontFamily="{StaticResource FluenceFontFamily}"
                                               FontSize="{StaticResource FluenceFontSizeBody}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource FluenceBrushTextPrimary}"/>
                                    <ItemsControl ItemsSource="{Binding Properties}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SettingsPropertyViewModel">
                                                <Grid ColumnDefinitions="240,*"
                                                      Margin="0,3">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Name}"
                                                               FontFamily="{StaticResource FluenceFontFamily}"
                                                               FontSize="{StaticResource FluenceFontSizeSmall}"
                                                               Foreground="{StaticResource FluenceBrushTextSecondary}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding TextValue, Mode=TwoWay}"
                                                             IsVisible="{Binding IsText}"
                                                             FontFamily="{StaticResource FluenceFontFamily}"
                                                             FontSize="{StaticResource FluenceFontSizeSmall}"/>
                                                    <ComboBox Grid.Column="1"
                                                              ItemsSource="{Binding ThemeOptions}"
                                                              SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                                              IsVisible="{Binding IsThemeSelector}"
                                                              FontFamily="{StaticResource FluenceFontFamily}"
                                                              FontSize="{StaticResource FluenceFontSizeSmall}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="theming:ThemeDescriptor">
                                                                <TextBlock Text="{Binding DisplayName}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <CheckBox Grid.Column="1"
                                                              IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                              IsVisible="{Binding IsBoolean}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Keybindings">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Keybindings}"
                                  Margin="18">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:KeybindingRowViewModel">
                                <Grid ColumnDefinitions="2*,Auto,180,Auto"
                                      ColumnSpacing="12"
                                      Margin="0,3">
                                    <StackPanel Grid.Column="0"
                                                Spacing="1">
                                        <TextBlock Text="{Binding Title}"
                                                   FontFamily="{StaticResource FluenceFontFamily}"
                                                   FontSize="{StaticResource FluenceFontSizeSmall}"
                                                   Foreground="{StaticResource FluenceBrushTextPrimary}"/>
                                        <TextBlock Text="{Binding CommandId}"
                                                   FontFamily="{StaticResource FluenceFontFamily}"
                                                   FontSize="{StaticResource FluenceFontSizeSmall}"
                                                   Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Scope}"
                                               Foreground="{StaticResource FluenceBrushTextSecondary}"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2"
                                             Text="{Binding Key, Mode=TwoWay}"
                                             KeyDown="OnKeybindingTextBoxKeyDown"
                                             FontFamily="{StaticResource FluenceFontFamily}"
                                             FontSize="{StaticResource FluenceFontSizeSmall}"/>
                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ConflictLabel}"
                                                   Foreground="{StaticResource FluenceBrushError}"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="{Binding RecordButtonText}"
                                                Command="{Binding StartRecordingCommand}"
                                                KeyDown="OnKeybindingRecordKeyDown"/>
                                        <Button Content="Reset"
                                                Command="{Binding ResetCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
