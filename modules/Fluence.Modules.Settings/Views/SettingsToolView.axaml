<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fluence.Modules.Settings.ViewModels"
             xmlns:theming="using:Fluence.Core.Models.Theming"
             xmlns:loc="using:Fluence.Core.Services.Localization"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Fluence.Modules.Settings.Views.SettingsToolView"
             x:DataType="vm:SettingsToolViewModel">
    <Grid RowDefinitions="Auto,Auto,*"
          Background="{StaticResource FluenceBrushShell}">
        <Grid.Styles>
            <Style Selector="Button.settingsToolbarIcon">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="MinHeight" Value="30"/>
            </Style>
            <Style Selector="Button.settingsListIcon">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
        </Grid.Styles>
        <Border Grid.Row="0"
                Padding="12,4"
                Background="{StaticResource FluenceBrushSurface}"
                BorderBrush="{StaticResource FluenceBrushBorder}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        Classes="ideIcon settingsToolbarIcon"
                        Command="{Binding RestoreDefaultsCommand}"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{Binding [Settings.Action.RestoreDefaults], Source={x:Static loc:Locale.Current}}">
                    <materialIcons:MaterialIcon Width="18"
                                                Height="18"
                                                Kind="Restore"
                                                Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                </Button>
                <TextBlock Grid.Column="1"
                           Classes="ideLabel"
                           Text="{Binding Status}"
                           Margin="12,0"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="6">
                    <Button Classes="ideIcon settingsToolbarIcon"
                            Command="{Binding InstallThemeCommand}"
                            ToolTip.Tip="{Binding [Settings.Action.InstallTheme], Source={x:Static loc:Locale.Current}}">
                        <materialIcons:MaterialIcon Width="18"
                                                    Height="18"
                                                    Kind="Download"
                                                    Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                    </Button>
                    <Button Classes="ideIcon ideAccent settingsToolbarIcon"
                            Command="{Binding SaveCommand}"
                            ToolTip.Tip="{Binding [Settings.Action.SaveAndApply], Source={x:Static loc:Locale.Current}}">
                        <materialIcons:MaterialIcon Width="18"
                                                    Height="18"
                                                    Kind="Check"
                                                    Foreground="{StaticResource FluenceBrushAccent}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1"
                Padding="12,6"
                Background="{StaticResource FluenceBrushShell}">
            <Grid ColumnDefinitions="Auto,320,*"
                  ColumnSpacing="8"
                  HorizontalAlignment="Left">
                <materialIcons:MaterialIcon Grid.Column="0"
                                            Width="18"
                                            Height="18"
                                            Kind="Magnify"
                                            Foreground="{StaticResource FluenceBrushTextSecondary}"
                                            VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         Classes="ideCompact"
                         PlaceholderText="{Binding [Settings.Search.Placeholder], Source={x:Static loc:Locale.Current}}"
                         Text="{Binding SearchQuery, Mode=TwoWay}"/>
            </Grid>
        </Border>
        <TabControl Grid.Row="2"
                    Margin="0,4,0,0"
                    SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="{Binding [Settings.Tab.Settings], Source={x:Static loc:Locale.Current}}">
                <Grid ColumnDefinitions="240,*"
                      Background="{StaticResource FluenceBrushShell}">
                    <Border Grid.Column="0"
                            Background="{StaticResource FluenceBrushSurface}"
                            BorderBrush="{StaticResource FluenceBrushBorder}"
                            BorderThickness="0,0,1,0"
                            Padding="10,10,8,10">
                        <Grid RowDefinitions="Auto,*"
                              RowSpacing="8">
                            <TextBlock Text="{Binding [Settings.Tab.Settings], Source={x:Static loc:Locale.Current}}"
                                       FontFamily="{StaticResource FluenceFontFamily}"
                                       FontSize="{StaticResource FluenceFontSizeSmall}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource FluenceBrushTextSecondary}"
                                       Margin="2,1,2,0"/>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Sections}"
                                     SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="8,5"/>
                                        <Setter Property="Margin" Value="0,1"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="CornerRadius" Value="3"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{StaticResource FluenceBrushSurfaceElevated}"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{StaticResource FluenceBrushSurfaceElevated}"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource FluenceBrushAccent}"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SettingsSectionViewModel">
                                        <StackPanel Spacing="0">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontFamily="{StaticResource FluenceFontFamily}"
                                                       FontSize="{StaticResource FluenceFontSizeSmall}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Column="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,18,28,28"
                                    Spacing="14"
                                    MaxWidth="1040"
                                    HorizontalAlignment="Left">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding [Settings.Label.Preferences], Source={x:Static loc:Locale.Current}}"
                                           FontFamily="{StaticResource FluenceFontFamily}"
                                           FontSize="{StaticResource FluenceFontSizeSmall}"
                                           Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Settings.Tab.Settings], Source={x:Static loc:Locale.Current}}"
                                               FontFamily="{StaticResource FluenceFontFamily}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource FluenceBrushTextPrimary}"/>
                                    <TextBlock Text=">"
                                               FontFamily="{StaticResource FluenceFontFamily}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                                    <TextBlock Text="{Binding SettingsContextTitle}"
                                               FontFamily="{StaticResource FluenceFontFamily}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource FluenceBrushAccent}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding FilteredSections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SettingsSectionViewModel">
                                        <StackPanel Spacing="8"
                                                    Margin="0,0,0,8">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontFamily="{StaticResource FluenceFontFamily}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource FluenceBrushTextPrimary}"
                                                       TextWrapping="Wrap"/>
                                            <ItemsControl ItemsSource="{Binding FilteredProperties}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:SettingsPropertyViewModel">
                                                        <Border BorderBrush="{StaticResource FluenceBrushBorder}"
                                                                BorderThickness="0,0,0,1"
                                                                Padding="0,12,0,12"
                                                                Margin="0,0,0,2">
                                                            <Grid ColumnDefinitions="300,*"
                                                                  ColumnSpacing="20">
                                                                <StackPanel Grid.Column="0"
                                                                            Spacing="4">
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               FontFamily="{StaticResource FluenceFontFamily}"
                                                                               FontSize="{StaticResource FluenceFontSizeBody}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource FluenceBrushTextPrimary}"
                                                                               TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding Description}"
                                                                               Classes="ideLabel"
                                                                               FontFamily="{StaticResource FluenceFontFamily}"
                                                                               FontSize="{StaticResource FluenceFontSizeSmall}"
                                                                               Foreground="{StaticResource FluenceBrushTextSecondary}"
                                                                               TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1"
                                                                            Spacing="6"
                                                                            VerticalAlignment="Center">
                                                                    <TextBox Width="360"
                                                                             Classes="ideCompact"
                                                                             Text="{Binding TextValue, Mode=TwoWay}"
                                                                             IsVisible="{Binding IsText}"/>
                                                                    <ComboBox Width="360"
                                                                              Classes="ideCompact"
                                                                              ItemsSource="{Binding ThemeOptions}"
                                                                              SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                                                              IsVisible="{Binding IsThemeSelector}">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate x:DataType="theming:ThemeDescriptor">
                                                                                <TextBlock Text="{Binding DisplayName}"/>
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                    <ComboBox Width="360"
                                                                              Classes="ideCompact"
                                                                              ItemsSource="{Binding EnumOptions}"
                                                                              SelectedItem="{Binding SelectedEnumValue, Mode=TwoWay}"
                                                                              IsVisible="{Binding IsEnum}"/>
                                                                    <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                                              IsVisible="{Binding IsBoolean}"
                                                                              VerticalAlignment="Center"
                                                                              Margin="0,2,0,0"/>
                                                                    <StackPanel Spacing="6"
                                                                                IsVisible="{Binding IsStringArray}">
                                                                        <ScrollViewer MaxHeight="180"
                                                                                      VerticalScrollBarVisibility="Auto"
                                                                                      HorizontalScrollBarVisibility="Disabled"
                                                                                      PointerWheelChanged="OnSuppressionsScrollWheel">
                                                                            <ItemsControl ItemsSource="{Binding StringArrayItems}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:SettingsStringArrayItemViewModel">
                                                                                        <Border Classes="ideRow"
                                                                                                Padding="6,5"
                                                                                                Margin="0,0,0,2">
                                                                                            <Grid ColumnDefinitions="*,28">
                                                                                                <StackPanel VerticalAlignment="Center"
                                                                                                            Spacing="1">
                                                                                                    <TextBlock Text="{Binding Value}"
                                                                                                               Classes="ideValue"
                                                                                                               FontWeight="SemiBold"/>
                                                                                                    <TextBlock Text="{Binding Title}"
                                                                                                               Classes="ideLabel"
                                                                                                               IsVisible="{Binding IsKnownRule}"/>
                                                                                                </StackPanel>
                                                                                                <Button Grid.Column="1"
                                                                                                        Classes="ideIcon"
                                                                                                        Width="28"
                                                                                                        Height="28"
                                                                                                        MinHeight="28"
                                                                                                        Command="{Binding RemoveCommand}"
                                                                                                        ToolTip.Tip="{Binding [Settings.Action.Remove], Source={x:Static loc:Locale.Current}}">
                                                                                                    <materialIcons:MaterialIcon Width="14"
                                                                                                                                Height="14"
                                                                                                                                Kind="Close"
                                                                                                                                Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                                                                                                </Button>
                                                                                            </Grid>
                                                                                        </Border>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </ScrollViewer>
                                                                        <Grid ColumnDefinitions="*,32"
                                                                              ColumnSpacing="6">
                                                                            <ComboBox Grid.Column="0"
                                                                                      Classes="ideCompact"
                                                                                      VerticalAlignment="Center"
                                                                                      ItemsSource="{Binding AvailableKnownRulesToAdd}"
                                                                                      SelectedItem="{Binding SelectedKnownRuleToAdd, Mode=TwoWay}"
                                                                                      PlaceholderText="{Binding [Settings.StringArray.AddKnownRule], Source={x:Static loc:Locale.Current}}">
                                                                                <ComboBox.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:SettingsKnownStringArrayOptionViewModel">
                                                                                        <TextBlock Text="{Binding DisplayText}"
                                                                                                   VerticalAlignment="Center"/>
                                                                                    </DataTemplate>
                                                                                </ComboBox.ItemTemplate>
                                                                            </ComboBox>
                                                                            <Button Grid.Column="1"
                                                                                    Classes="ideGhost"
                                                                                    Width="32"
                                                                                    Height="26"
                                                                                    MinHeight="26"
                                                                                    Padding="0"
                                                                                    HorizontalContentAlignment="Center"
                                                                                    VerticalContentAlignment="Center"
                                                                                    Command="{Binding AddSelectedKnownRuleCommand}"
                                                                                    ToolTip.Tip="{Binding [Settings.Action.AddRule], Source={x:Static loc:Locale.Current}}">
                                                                                <materialIcons:MaterialIcon Width="14"
                                                                                                            Height="14"
                                                                                                            Kind="Plus"
                                                                                                            Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                                                                            </Button>
                                                                        </Grid>
                                                                        <Grid ColumnDefinitions="*,32"
                                                                              ColumnSpacing="6">
                                                                            <TextBox Grid.Column="0"
                                                                                     Classes="ideCompact"
                                                                                     PlaceholderText="{Binding [Settings.StringArray.CustomIdPlaceholder], Source={x:Static loc:Locale.Current}}"
                                                                                     Text="{Binding NewStringArrayValue, Mode=TwoWay}"/>
                                                                            <Button Grid.Column="1"
                                                                                    Classes="ideGhost"
                                                                                    Width="32"
                                                                                    Height="26"
                                                                                    MinHeight="26"
                                                                                    Padding="0"
                                                                                    HorizontalContentAlignment="Center"
                                                                                    VerticalContentAlignment="Center"
                                                                                    Command="{Binding AddCustomStringArrayValueCommand}"
                                                                                    ToolTip.Tip="{Binding [Settings.Action.AddCustomId], Source={x:Static loc:Locale.Current}}">
                                                                                <materialIcons:MaterialIcon Width="14"
                                                                                                            Height="14"
                                                                                                            Kind="Plus"
                                                                                                            Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                                                                            </Button>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="{Binding [Settings.Tab.Keybindings], Source={x:Static loc:Locale.Current}}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredKeybindings}"
                                  Margin="18,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:KeybindingRowViewModel">
                                <Grid ColumnDefinitions="2*,90,160,116"
                                      ColumnSpacing="10"
                                      Margin="0,2">
                                    <StackPanel Grid.Column="0"
                                                Spacing="1">
                                        <TextBlock Text="{Binding Title}"
                                                   Classes="ideValue"
                                                   FontFamily="{StaticResource FluenceFontFamily}"
                                                   FontSize="{StaticResource FluenceFontSizeSmall}"
                                                   Foreground="{StaticResource FluenceBrushTextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CommandId}"
                                                   Classes="ideLabel"
                                                   FontFamily="{StaticResource FluenceFontFamily}"
                                                   FontSize="{StaticResource FluenceFontSizeSmall}"
                                                   Foreground="{StaticResource FluenceBrushTextSecondary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Classes="ideLabel"
                                               Text="{Binding Scope}"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2"
                                             Classes="ideCompact"
                                             Width="160"
                                             Text="{Binding Key, Mode=TwoWay}"/>
                                    <Grid Grid.Column="3"
                                          ColumnDefinitions="32,36,36"
                                          ColumnSpacing="6"
                                          VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Grid.Column="0"
                                                                    Width="20"
                                                                    Height="20"
                                                                    Kind="AlertCircleOutline"
                                                                    Foreground="{StaticResource FluenceBrushError}"
                                                                    IsVisible="{Binding HasConflict}"
                                                                    ToolTip.Tip="{Binding [Settings.Keybinding.Conflict], Source={x:Static loc:Locale.Current}}"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Center"/>
                                        <Button Classes="ideIcon"
                                                Grid.Column="1"
                                                Command="{Binding StartRecordingCommand}"
                                                ToolTip.Tip="{Binding RecordButtonText}">
                                            <materialIcons:MaterialIcon Width="20"
                                                                        Height="20"
                                                                        Kind="RecordCircle"
                                                                        Foreground="{Binding RecordIconBrush}"/>
                                        </Button>
                                        <Button Classes="ideIcon"
                                                Grid.Column="2"
                                                Command="{Binding ResetCommand}"
                                                ToolTip.Tip="{Binding [Settings.Action.Reset], Source={x:Static loc:Locale.Current}}">
                                            <materialIcons:MaterialIcon Width="20"
                                                                        Height="20"
                                                                        Kind="Restore"
                                                                        Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
