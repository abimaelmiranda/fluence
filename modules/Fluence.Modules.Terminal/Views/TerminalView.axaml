<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fluence.Modules.Terminal.ViewModels"
             xmlns:terminal="using:Fluence.Modules.Terminal.Terminal"
             x:Class="Fluence.Modules.Terminal.Views.TerminalView"
             x:DataType="vm:TerminalViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="#1A1D23">

    <terminal:TerminalControl x:Name="TerminalControl"
                              Terminal="{Binding XTerminal}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"/>

</UserControl>
