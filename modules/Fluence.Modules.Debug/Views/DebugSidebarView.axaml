<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Fluence.Modules.Debug.Models"
             xmlns:vm="using:Fluence.Modules.Debug.ViewModels"
             x:Class="Fluence.Modules.Debug.Views.DebugSidebarView"
             x:DataType="vm:DebugSidebarViewModel"
             Background="Transparent">

    <StackPanel Spacing="10"
                Margin="10">
        <Border Padding="10"
                Classes="idePanel">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding SessionTitle}"
                           FontFamily="{StaticResource FluenceFontFamily}"
                           FontSize="{StaticResource FluenceFontSizeSmall}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource FluenceBrushTextPrimary}"/>
                <TextBlock Text="{Binding Architecture}"
                           FontFamily="{StaticResource FluenceFontFamily}"
                           FontSize="{StaticResource FluenceFontSizeSmall}"
                           Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                <TextBlock Text="{Binding Status}"
                           FontFamily="{StaticResource FluenceFontFamily}"
                           FontSize="{StaticResource FluenceFontSizeSmall}"
                           Foreground="{StaticResource FluenceBrushTextSecondary}"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal"
                    Spacing="4">
            <Button Width="36"
                    Height="36"
                    Padding="0"
                    Classes="ideIcon"
                    Command="{Binding ContinueCommand}"
                    IsEnabled="{Binding CanControlExecution}"
                    ToolTip.Tip="Continue">
                <Path Data="{x:Static models:DebugToolbarIconCatalog.ContinueIcon}"
                      Width="18"
                      Height="18"
                      Stretch="Uniform"
                      Fill="{StaticResource FluenceBrushTextPrimary}"/>
            </Button>
            <Button Width="36"
                    Height="36"
                    Padding="0"
                    Classes="ideIcon"
                    Command="{Binding StepOverCommand}"
                    IsEnabled="{Binding CanControlExecution}"
                    ToolTip.Tip="Step over">
                <Path Data="{x:Static models:DebugToolbarIconCatalog.StepOverIcon}"
                      Width="18"
                      Height="18"
                      Stretch="Uniform"
                      Fill="{StaticResource FluenceBrushTextPrimary}"/>
            </Button>
            <Button Width="36"
                    Height="36"
                    Padding="0"
                    Classes="ideIcon"
                    Command="{Binding StepIntoCommand}"
                    IsEnabled="{Binding CanControlExecution}"
                    ToolTip.Tip="Step into">
                <Path Data="{x:Static models:DebugToolbarIconCatalog.StepIntoIcon}"
                      Width="18"
                      Height="18"
                      Stretch="Uniform"
                      Fill="{StaticResource FluenceBrushTextPrimary}"/>
            </Button>
            <Button Width="36"
                    Height="36"
                    Padding="0"
                    Classes="ideIcon"
                    Command="{Binding StepOutCommand}"
                    IsEnabled="{Binding CanControlExecution}"
                    ToolTip.Tip="Step out">
                <Path Data="{x:Static models:DebugToolbarIconCatalog.StepOutIcon}"
                      Width="18"
                      Height="18"
                      Stretch="Uniform"
                      Fill="{StaticResource FluenceBrushTextPrimary}"/>
            </Button>
            <Button Width="36"
                    Height="36"
                    Padding="0"
                    Classes="ideIcon"
                    Command="{Binding StopCommand}"
                    IsEnabled="{Binding CanRestartSession}"
                    ToolTip.Tip="Stop debug">
                <Path Data="{x:Static models:DebugToolbarIconCatalog.StopIcon}"
                      Width="18"
                      Height="18"
                      Stretch="Uniform"
                      Fill="{StaticResource FluenceBrushTextPrimary}"/>
            </Button>
            <Button Width="36"
                    Height="36"
                    Padding="0"
                    Classes="ideIcon"
                    Command="{Binding ReloadCommand}"
                    IsEnabled="{Binding CanRestartSession}"
                    ToolTip.Tip="Reload session">
                <Path Data="{x:Static models:DebugToolbarIconCatalog.ReloadIcon}"
                      Width="18"
                      Height="18"
                      Stretch="Uniform"
                      Fill="{StaticResource FluenceBrushTextPrimary}"/>
            </Button>
        </StackPanel>

        <Border Padding="10"
                Classes="idePanel">
            <StackPanel Spacing="8">
                <TextBlock Text="Variables"
                           FontFamily="{StaticResource FluenceFontFamily}"
                           FontSize="{StaticResource FluenceFontSizeSmall}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource FluenceBrushTextPrimary}"/>
                <ItemsControl ItemsSource="{Binding Variables}"/>
            </StackPanel>
        </Border>

        <Border Padding="10"
                Classes="idePanel">
            <StackPanel Spacing="8">
                <TextBlock Text="Call Stack"
                           FontFamily="{StaticResource FluenceFontFamily}"
                           FontSize="{StaticResource FluenceFontSizeSmall}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource FluenceBrushTextPrimary}"/>
                <ItemsControl ItemsSource="{Binding StackFrames}"/>
            </StackPanel>
        </Border>

        <Border Padding="10"
                Classes="idePanel">
            <StackPanel Spacing="8">
                <TextBlock Text="Breakpoints"
                           FontFamily="{StaticResource FluenceFontFamily}"
                           FontSize="{StaticResource FluenceFontSizeSmall}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource FluenceBrushTextPrimary}"/>
                <ItemsControl ItemsSource="{Binding Breakpoints}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
