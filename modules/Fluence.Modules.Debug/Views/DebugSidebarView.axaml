<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fluence.Modules.Debug.ViewModels"
             x:Class="Fluence.Modules.Debug.Views.DebugSidebarView"
             x:DataType="vm:DebugSidebarViewModel"
             Background="Transparent">

    <StackPanel Spacing="10"
                Margin="10">
        <Border Padding="10"
                Background="{StaticResource FluenceBrushShell}"
                BorderBrush="{StaticResource FluenceBrushBorder}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding SessionTitle}"
                           FontFamily="{StaticResource FluenceFontFamily}"
                           FontSize="{StaticResource FluenceFontSizeSmall}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource FluenceBrushTextPrimary}"/>
                <TextBlock Text="{Binding StartupProject}"
                           FontFamily="{StaticResource FluenceFontFamily}"
                           FontSize="{StaticResource FluenceFontSizeSmall}"
                           Foreground="{StaticResource FluenceBrushTextSecondary}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Architecture}"
                           FontFamily="{StaticResource FluenceFontFamily}"
                           FontSize="{StaticResource FluenceFontSizeSmall}"
                           Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                <TextBlock Text="{Binding Status}"
                           FontFamily="{StaticResource FluenceFontFamily}"
                           FontSize="{StaticResource FluenceFontSizeSmall}"
                           Foreground="{StaticResource FluenceBrushTextSecondary}"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal"
                    Spacing="4">
            <Button Content="Continue"
                    Command="{Binding ContinueCommand}"
                    IsEnabled="{Binding CanControlExecution}"
                    Height="26"
                    FontSize="{StaticResource FluenceFontSizeSmall}"/>
            <Button Content="Over"
                    Command="{Binding StepOverCommand}"
                    IsEnabled="{Binding CanControlExecution}"
                    Height="26"
                    FontSize="{StaticResource FluenceFontSizeSmall}"/>
            <Button Content="Into"
                    Command="{Binding StepIntoCommand}"
                    IsEnabled="{Binding CanControlExecution}"
                    Height="26"
                    FontSize="{StaticResource FluenceFontSizeSmall}"/>
            <Button Content="Out"
                    Command="{Binding StepOutCommand}"
                    IsEnabled="{Binding CanControlExecution}"
                    Height="26"
                    FontSize="{StaticResource FluenceFontSizeSmall}"/>
            <Button Content="Stop"
                    Command="{Binding StopCommand}"
                    Height="26"
                    FontSize="{StaticResource FluenceFontSizeSmall}"/>
        </StackPanel>

        <Border Padding="10"
                Background="{StaticResource FluenceBrushShell}"
                BorderBrush="{StaticResource FluenceBrushBorder}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel Spacing="8">
                <TextBlock Text="Variables"
                           FontFamily="{StaticResource FluenceFontFamily}"
                           FontSize="{StaticResource FluenceFontSizeSmall}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource FluenceBrushTextPrimary}"/>
                <ItemsControl ItemsSource="{Binding Variables}"/>
            </StackPanel>
        </Border>

        <Border Padding="10"
                Background="{StaticResource FluenceBrushShell}"
                BorderBrush="{StaticResource FluenceBrushBorder}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel Spacing="8">
                <TextBlock Text="Call Stack"
                           FontFamily="{StaticResource FluenceFontFamily}"
                           FontSize="{StaticResource FluenceFontSizeSmall}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource FluenceBrushTextPrimary}"/>
                <ItemsControl ItemsSource="{Binding StackFrames}"/>
            </StackPanel>
        </Border>

        <Border Padding="10"
                Background="{StaticResource FluenceBrushShell}"
                BorderBrush="{StaticResource FluenceBrushBorder}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel Spacing="8">
                <TextBlock Text="Breakpoints"
                           FontFamily="{StaticResource FluenceFontFamily}"
                           FontSize="{StaticResource FluenceFontSizeSmall}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource FluenceBrushTextPrimary}"/>
                <ItemsControl ItemsSource="{Binding Breakpoints}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
