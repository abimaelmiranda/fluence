<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Fluence.Core.Services.Localization"
             xmlns:vm="using:Fluence.Modules.NuGetExplorer.ViewModels"
             xmlns:models="using:Fluence.Modules.NuGetExplorer.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Fluence.Modules.NuGetExplorer.Views.NuGetExplorerView"
             x:DataType="vm:NuGetExplorerViewModel"
             Background="{StaticResource FluenceBrushShell}">

    <Grid RowDefinitions="Auto,*" Margin="10" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0"
                       Text="{Binding [NuGetExplorer.Title], Source={x:Static loc:Locale.Current}}"
                       FontFamily="{StaticResource FluenceFontFamily}"
                       FontSize="{StaticResource FluenceFontSizeBody}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource FluenceBrushTextPrimary}"
                       VerticalAlignment="Center"/>
            <CheckBox Grid.Column="1"
                      Content="{Binding [NuGetExplorer.Option.IncludePrerelease], Source={x:Static loc:Locale.Current}}"
                      IsChecked="{Binding IncludePrerelease}"
                      FontFamily="{StaticResource FluenceFontFamily}"
                      Foreground="{StaticResource FluenceBrushTextSecondary}"
                      VerticalAlignment="Center"/>
            <Button Grid.Column="2"
                    Classes="ideIcon"
                    Command="{Binding RefreshCommand}"
                    ToolTip.Tip="{Binding [NuGetExplorer.Action.Refresh], Source={x:Static loc:Locale.Current}}">
                <materialIcons:MaterialIcon Width="20"
                                            Height="20"
                                            Kind="Refresh"
                                            Foreground="{StaticResource FluenceBrushTextSecondary}"/>
            </Button>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="{Binding [NuGetExplorer.Tab.Browse], Source={x:Static loc:Locale.Current}}">
                <Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="0,8,0,0">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="SearchTextBox"
                                 Classes="ideCompact"
                                 Grid.Column="0"
                                 PlaceholderText="{Binding [NuGetExplorer.Search.Placeholder], Source={x:Static loc:Locale.Current}}"
                                 Text="{Binding SearchQuery}"/>
                        <Button Grid.Column="1"
                                Classes="ideIcon ideAccent"
                                Command="{Binding SearchCommand}"
                                ToolTip.Tip="{Binding [NuGetExplorer.Action.Search], Source={x:Static loc:Locale.Current}}">
                            <materialIcons:MaterialIcon Width="20"
                                                        Height="20"
                                                        Kind="Magnify"
                                                        Foreground="{StaticResource FluenceBrushAccent}"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="2*,3*" ColumnSpacing="8">
                        <Border Grid.Column="0"
                                Classes="idePanel">
                            <ListBox ItemsSource="{Binding BrowseResults}"
                                     SelectedItem="{Binding SelectedBrowsePackage}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NuGetPackageSearchItem">
                                        <Grid ColumnDefinitions="32,*" ColumnSpacing="8" Margin="6,4">
                                            <Border Grid.Column="0"
                                                    Width="28"
                                                    Height="28"
                                                    CornerRadius="4"
                                                    Background="{StaticResource FluenceBrushSurface}"
                                                    BorderBrush="{StaticResource FluenceBrushBorder}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <TextBlock Text="📦"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="{StaticResource FluenceFontSizeSmall}"/>
                                                    <Image Source="{Binding Icon}"
                                                           Width="24"
                                                           Height="24"
                                                           Stretch="Uniform"
                                                           IsVisible="{Binding HasIcon}"/>
                                                </Grid>
                                            </Border>
                                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="0"
                                                           Text="{Binding Id}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource FluenceBrushTextPrimary}"/>
                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="1"
                                                           Text="{Binding Version}"
                                                           Margin="8,0,0,0"
                                                           Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                                                <TextBlock Grid.Row="1"
                                                           Grid.ColumnSpan="2"
                                                           Text="{Binding Description}"
                                                           MaxLines="1"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
                            <TextBlock Text="{Binding SelectedBrowsePackageTitle}"
                                       FontSize="{StaticResource FluenceFontSizeBody}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource FluenceBrushTextPrimary}"/>
                            <ComboBox Grid.Row="1"
                                      Classes="ideCompact"
                                      PlaceholderText="{Binding [NuGetExplorer.Label.SelectVersion], Source={x:Static loc:Locale.Current}}"
                                      ItemsSource="{Binding AvailableVersions}"
                                      SelectedItem="{Binding SelectedVersion}"
                                      MaxDropDownHeight="260"
                                      MaxWidth="240"
                                      HorizontalAlignment="Left" />
                            <Border Grid.Row="2"
                                    Classes="idePanel">
                                <ScrollViewer>
                                    <ItemsControl ItemsSource="{Binding TargetProjects}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:NuGetProjectSelection">
                                                <CheckBox Content="{Binding Name}"
                                                          IsChecked="{Binding DisplayIsChecked}"
                                                          IsEnabled="{Binding !IsAlreadyInstalled}"
                                                          Margin="6,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <Button Grid.Row="3"
                                    Classes="ideIcon ideAccent"
                                    Command="{Binding InstallSelectedPackageCommand}"
                                    IsEnabled="{Binding CanModifyPackages}"
                                    HorizontalAlignment="Right"
                                    ToolTip.Tip="{Binding [NuGetExplorer.Action.InstallSelected], Source={x:Static loc:Locale.Current}}">
                                <materialIcons:MaterialIcon Width="20"
                                                            Height="20"
                                                            Kind="Download"
                                                            Foreground="{StaticResource FluenceBrushAccent}"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding [NuGetExplorer.Tab.Installed], Source={x:Static loc:Locale.Current}}">
                <Grid RowDefinitions="*,Auto" RowSpacing="8" Margin="0,8,0,0">
                    <Border Grid.Row="0"
                            Classes="idePanel">
                        <Grid RowDefinitions="Auto,*">
                            <Grid Grid.Row="0"
                                  ColumnDefinitions="2*,*,*"
                                  Margin="6,4">
                                <TextBlock Grid.Column="0" Text="{Binding [NuGetExplorer.Column.Package], Source={x:Static loc:Locale.Current}}" Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding [NuGetExplorer.Column.Version], Source={x:Static loc:Locale.Current}}" Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                                <TextBlock Grid.Column="2" Text="{Binding [NuGetExplorer.Column.Project], Source={x:Static loc:Locale.Current}}" Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                            </Grid>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding InstalledPackages}"
                                     SelectedItem="{Binding SelectedInstalledPackage}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:NuGetInstalledPackage">
                                        <Grid ColumnDefinitions="2*,*,*" Margin="6,4">
                                            <TextBlock Grid.Column="0" Text="{Binding Id}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Version}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ProjectName}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Button Grid.Row="1"
                            Classes="ideIcon"
                            Command="{Binding RemoveSelectedPackageCommand}"
                            IsEnabled="{Binding CanModifyPackages}"
                            HorizontalAlignment="Right"
                            ToolTip.Tip="{Binding [NuGetExplorer.Action.RemoveSelected], Source={x:Static loc:Locale.Current}}">
                        <materialIcons:MaterialIcon Width="20"
                                                    Height="20"
                                                    Kind="Delete"
                                                    Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                    </Button>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding [NuGetExplorer.Tab.Updates], Source={x:Static loc:Locale.Current}}">
                <Grid RowDefinitions="*,Auto" RowSpacing="8" Margin="0,8,0,0">
                    <Border Grid.Row="0"
                            Classes="idePanel">
                        <Grid RowDefinitions="Auto,*">
                            <Grid Grid.Row="0"
                                  ColumnDefinitions="2*,*,*"
                                  Margin="6,4">
                                <TextBlock Grid.Column="0" Text="{Binding [NuGetExplorer.Column.Package], Source={x:Static loc:Locale.Current}}" Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding [NuGetExplorer.Column.Latest], Source={x:Static loc:Locale.Current}}" Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                                <TextBlock Grid.Column="2" Text="{Binding [NuGetExplorer.Column.AffectedProjects], Source={x:Static loc:Locale.Current}}" Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                            </Grid>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding UpdateCandidates}"
                                     SelectedItem="{Binding SelectedUpdate}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:NuGetPackageUpdate">
                                        <Grid ColumnDefinitions="2*,*,*" Margin="6,4">
                                            <TextBlock Grid.Column="0" Text="{Binding Id}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LatestVersion}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ProjectCountLabel}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Button Grid.Row="1"
                            Classes="ideIcon ideAccent"
                            Command="{Binding UpdateSelectedPackageCommand}"
                            IsEnabled="{Binding CanModifyPackages}"
                            HorizontalAlignment="Right"
                            ToolTip.Tip="{Binding [NuGetExplorer.Action.UpdateSelected], Source={x:Static loc:Locale.Current}}">
                        <materialIcons:MaterialIcon Width="20"
                                                    Height="20"
                                                    Kind="Update"
                                                    Foreground="{StaticResource FluenceBrushAccent}"/>
                    </Button>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                Background="{StaticResource FluenceBrushSurface}"
                Padding="8"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Left"
                IsVisible="{Binding HasStatusMessage}">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource FluenceBrushTextSecondary}"/>
        </Border>
    </Grid>
</UserControl>
