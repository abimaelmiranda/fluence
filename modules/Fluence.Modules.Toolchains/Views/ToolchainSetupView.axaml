<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fluence.Modules.Toolchains.ViewModels"
             x:Class="Fluence.Modules.Toolchains.Views.ToolchainSetupView"
             x:DataType="vm:ToolchainSetupViewModel"
             Background="{StaticResource FluenceBrushShell}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="{Binding Title}"
                 FontSize="{StaticResource FluenceFontSizeTitle}"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource FluenceBrushTextPrimary}" />
      <TextBlock Text="{Binding Subtitle}"
                 Classes="ideLabel"
                 TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="1" Classes="idePanel" Padding="12">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <TextBlock Text="{Binding Output}"
                   FontFamily="Menlo,Cascadia Mono,Consolas,monospace"
                   FontSize="{StaticResource FluenceFontSizeSmall}"
                   Foreground="{StaticResource FluenceBrushTextSecondary}"
                   TextWrapping="Wrap" />
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsRunning}">
        <ProgressBar IsIndeterminate="True" Width="160" Height="4" />
        <TextBlock Text="Installing..." Classes="ideLabel" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Grid.Column="0"
                 Text="{Binding ErrorMessage}"
                 Foreground="#FF6B6B"
                 FontSize="{StaticResource FluenceFontSizeSmall}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Classes="ideToolbar"
                Content="Retry"
                Command="{Binding RetryCommand}"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Button Classes="ideToolbar"
                Content="Cancel"
                Command="{Binding CancelCommand}"
                IsVisible="{Binding IsRunning}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
