<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Fluence.Core.Services.Localization"
             xmlns:vm="using:Fluence.Modules.DotnetCli.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Fluence.Modules.DotnetCli.Views.DotnetSdkSetupView"
             x:DataType="vm:DotnetSdkSetupViewModel"
             Background="{StaticResource FluenceBrushShell}">
    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Background="{StaticResource FluenceBrushShell}">
        <Grid.Styles>
            <Style Selector="Button.sdkToolbarIcon">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="MinHeight" Value="30"/>
            </Style>
            <Style Selector="TextBlock.sdkSectionTitle">
                <Setter Property="FontFamily" Value="{StaticResource FluenceFontFamily}"/>
                <Setter Property="FontSize" Value="{StaticResource FluenceFontSizeBody}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource FluenceBrushTextPrimary}"/>
            </Style>
        </Grid.Styles>

        <Border Grid.Row="0"
                Padding="12,4"
                Background="{StaticResource FluenceBrushSurface}"
                BorderBrush="{StaticResource FluenceBrushBorder}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding [DotnetCli.Title.Sdk], Source={x:Static loc:Locale.Current}}"
                           FontFamily="{StaticResource FluenceFontFamily}"
                           FontSize="{StaticResource FluenceFontSizeBody}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource FluenceBrushTextPrimary}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Classes="ideLabel"
                           Text="{Binding Status}"
                           Margin="14,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="6">
                    <Button Classes="ideIcon sdkToolbarIcon"
                            Command="{Binding RefreshSdkCommand}"
                        ToolTip.Tip="{Binding [DotnetCli.Action.Refresh], Source={x:Static loc:Locale.Current}}">
                        <materialIcons:MaterialIcon Width="18"
                                                    Height="18"
                                                    Kind="Refresh"
                                                    Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                    </Button>
                    <Button Classes="ideToolbar ideAccent"
                            Command="{Binding InstallOfficialCommand}"
                            Content="{Binding [DotnetCli.Action.InstallSelected], Source={x:Static loc:Locale.Current}}"/>
                    <Button Classes="ideToolbar"
                            Command="{Binding RetrySystemWideCommand}"
                            Content="{Binding [DotnetCli.Action.SystemWide], Source={x:Static loc:Locale.Current}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Padding="12,8"
                Background="{StaticResource FluenceBrushShell}">
            <Grid ColumnDefinitions="150,*" ColumnSpacing="14">
                <TextBlock Grid.Column="0"
                           Classes="ideLabel"
                           Text="{Binding [DotnetCli.Label.ActiveDotnet], Source={x:Static loc:Locale.Current}}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1"
                            Spacing="2">
                    <TextBlock Text="{Binding DotnetPath}"
                               Classes="ideValue"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding IdeManagedInstallPath}"
                               Classes="ideLabel"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              ColumnDefinitions="520,*"
              ColumnSpacing="14"
              Margin="18,10,18,10">
            <StackPanel Grid.Column="0"
                        Spacing="8">
                <TextBlock Text="{Binding [DotnetCli.Label.Sdks], Source={x:Static loc:Locale.Current}}"
                           Classes="sdkSectionTitle"/>
                <Border Classes="idePanel"
                        Padding="8"
                        MinHeight="280">
                    <ListBox ItemsSource="{Binding SdkOptions}"
                             SelectedItem="{Binding SelectedSdkOption}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DotnetSdkOptionViewModel">
                                <Grid RowDefinitions="Auto,Auto,Auto"
                                      ColumnDefinitions="*,Auto"
                                      Margin="4,5">
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="{Binding DisplayName}"
                                               Classes="ideValue"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               Text="{Binding StateText}"
                                               Classes="ideLabel"/>
                                    <TextBlock Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding Description}"
                                               Classes="ideLabel"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding InstalledPath}"
                                               Classes="ideLabel"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding IsInstalled}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Spacing="8">
                <TextBlock Text="{Binding [DotnetCli.Label.InstallLog], Source={x:Static loc:Locale.Current}}"
                           Classes="sdkSectionTitle"/>
                <Border Classes="idePanel"
                        Padding="10"
                        MinHeight="280">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding Output}"
                                   FontFamily="Menlo,Cascadia Mono,Consolas,monospace"
                                   FontSize="{StaticResource FluenceFontSizeSmall}"
                                   Foreground="{StaticResource FluenceBrushTextSecondary}"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Grid>

        <ProgressBar Grid.Row="3"
                     Height="4"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsRunning}"/>
    </Grid>
</UserControl>
