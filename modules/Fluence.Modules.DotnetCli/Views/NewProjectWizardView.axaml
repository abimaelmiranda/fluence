<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Fluence.Core.Services.Localization"
             xmlns:proj="using:Fluence.Core.Abstractions.Projects"
             xmlns:vm="using:Fluence.Modules.DotnetCli.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Fluence.Modules.DotnetCli.Views.NewProjectWizardView"
             x:DataType="vm:NewProjectWizardViewModel"
             Background="{StaticResource FluenceBrushShell}">
    <UserControl.Styles>
        <Style Selector="ComboBox.wizardField">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.wizardField">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.wizardAction">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ListBox.wizardTemplates">
            <Setter Property="Padding" Value="0"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="18" RowSpacing="12">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,180,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding [DotnetCli.Title.NewProject], Source={x:Static loc:Locale.Current}}"
                       FontFamily="{StaticResource FluenceFontFamily}"
                       FontSize="{StaticResource FluenceFontSizeTitle}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource FluenceBrushTextPrimary}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="Language"
                       Classes="ideLabel"
                       VerticalAlignment="Center"/>
            <ComboBox Grid.Column="2"
                      Classes="wizardField"
                      ItemsSource="{Binding Providers}"
                      SelectedItem="{Binding SelectedProvider}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}"
                                   Classes="ideValue"
                                   TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="3"
                    Classes="ideIcon"
                    Command="{Binding OpenProviderSetupCommand}"
                    IsVisible="{Binding CanOpenProviderSetup}"
                    ToolTip.Tip="{Binding [DotnetCli.ToolTip.Sdk], Source={x:Static loc:Locale.Current}}">
                <materialIcons:MaterialIcon Width="20"
                                            Height="20"
                                            Kind="Download"
                                            Foreground="{StaticResource FluenceBrushTextSecondary}"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="340,*" ColumnSpacing="18">
            <Grid Grid.Column="0"
                  RowDefinitions="Auto,*"
                  RowSpacing="8">
                <TextBlock Text="{Binding [DotnetCli.Label.Templates], Source={x:Static loc:Locale.Current}}"
                           FontFamily="{StaticResource FluenceFontFamily}"
                           FontSize="{StaticResource FluenceFontSizeBody}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource FluenceBrushTextPrimary}"/>
                <Border Grid.Row="1"
                        Classes="idePanel"
                        Padding="6">
                    <ListBox Classes="wizardTemplates"
                             ItemsSource="{Binding Templates}"
                             SelectedItem="{Binding SelectedTemplate}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="proj:ProjectTemplateDefinition">
                                <Grid RowDefinitions="Auto,Auto"
                                      Height="58"
                                      Margin="8,4"
                                      VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               Classes="ideValue"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Description}"
                                       Classes="ideLabel"
                                       TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <Grid Grid.Column="1"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*"
                  RowSpacing="12">
                <Grid Grid.Row="0" ColumnDefinitions="150,*" ColumnSpacing="12">
                    <TextBlock Text="{Binding [DotnetCli.Label.ProjectName], Source={x:Static loc:Locale.Current}}"
                               Classes="ideLabel"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             Classes="wizardField"
                             Text="{Binding ProjectName}"/>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="150,*,Auto" ColumnSpacing="12">
                    <TextBlock Text="{Binding [DotnetCli.Label.Location], Source={x:Static loc:Locale.Current}}"
                               Classes="ideLabel"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             Classes="wizardField"
                             Text="{Binding Location}"/>
                    <Button Grid.Column="2"
                            Classes="ideIcon"
                            Command="{Binding BrowseLocationCommand}"
                            ToolTip.Tip="{Binding [DotnetCli.ToolTip.ChooseLocation], Source={x:Static loc:Locale.Current}}">
                        <materialIcons:MaterialIcon Width="20"
                                                    Height="20"
                                                    Kind="FolderOpen"
                                                    Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                    </Button>
                </Grid>

                <Grid Grid.Row="2" ColumnDefinitions="150,180,*" ColumnSpacing="12"
                      IsVisible="{Binding CanSelectFramework}">
                    <TextBlock Text="{Binding [DotnetCli.Label.Framework], Source={x:Static loc:Locale.Current}}"
                               Classes="ideLabel"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              Classes="wizardField"
                              ItemsSource="{Binding Frameworks}"
                              SelectedItem="{Binding SelectedFramework}"/>
                </Grid>

                <Grid Grid.Row="3" ColumnDefinitions="150,*" ColumnSpacing="12"
                      IsVisible="{Binding CanCreateSolution}">
                    <TextBlock Text="{Binding [DotnetCli.Label.Solution], Source={x:Static loc:Locale.Current}}"
                               Classes="ideLabel"
                               VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1"
                              Content="{Binding [DotnetCli.Option.CreateSolution], Source={x:Static loc:Locale.Current}}"
                              IsChecked="{Binding CreateSolution}"
                              Foreground="{StaticResource FluenceBrushTextSecondary}"
                              VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="4" ColumnDefinitions="150,*" ColumnSpacing="12"
                      IsVisible="{Binding CanCreateSolution}">
                    <TextBlock Text="{Binding [DotnetCli.Label.SolutionName], Source={x:Static loc:Locale.Current}}"
                               Classes="ideLabel"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             Classes="wizardField"
                             Text="{Binding SolutionName}"/>
                </Grid>

                <Grid Grid.Row="5" ColumnDefinitions="150,*" ColumnSpacing="12"
                      IsVisible="{Binding CanCreateSolution}">
                    <TextBlock Text="{Binding [DotnetCli.Label.SolutionLocation], Source={x:Static loc:Locale.Current}}"
                               Classes="ideLabel"
                               VerticalAlignment="Top"
                               Margin="0,4,0,0"/>
                    <CheckBox Grid.Column="1"
                              Content="{Binding [DotnetCli.Option.PlaceSolutionInProjectFolder], Source={x:Static loc:Locale.Current}}"
                              IsChecked="{Binding PlaceSolutionInProjectFolder}"
                              Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                </Grid>

                <Grid Grid.Row="6" ColumnDefinitions="150,*" ColumnSpacing="12">
                    <TextBlock Text="{Binding [DotnetCli.Label.AfterCreate], Source={x:Static loc:Locale.Current}}"
                               Classes="ideLabel"
                               VerticalAlignment="Top"
                               Margin="0,4,0,0"/>
                    <CheckBox Grid.Column="1"
                              Content="{Binding [DotnetCli.Option.OpenWorkspace], Source={x:Static loc:Locale.Current}}"
                              IsChecked="{Binding OpenAfterCreate}"
                              Foreground="{StaticResource FluenceBrushTextSecondary}"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressBar Width="140"
                             Height="4"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsRunning}"/>
                <TextBlock Text="{Binding Status}"
                           Classes="ideLabel"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="ideAccent wizardAction"
                    Command="{Binding CreateProjectCommand}">
                <StackPanel Orientation="Horizontal"
                            Spacing="7"
                            VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Width="18"
                                                Height="18"
                                                VerticalAlignment="Center"
                                                Kind="PlusBox"
                                                Foreground="{StaticResource FluenceBrushAccent}"/>
                    <TextBlock Text="{Binding [DotnetCli.Action.Create], Source={x:Static loc:Locale.Current}}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
