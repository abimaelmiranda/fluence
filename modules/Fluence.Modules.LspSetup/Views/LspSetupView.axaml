<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fluence.Modules.LspSetup.ViewModels"
             xmlns:loc="using:Fluence.Core.Services.Localization"
             x:Class="Fluence.Modules.LspSetup.Views.LspSetupView"
             x:DataType="vm:LspSetupViewModel"
             Background="#0A0A0A">

  <Grid RowDefinitions="Auto,*,Auto" Margin="24">

    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="{Binding [LspSetup.Header.Title], Source={x:Static loc:Locale.Current}}"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Foreground="#9D67FF" />
      <TextBlock Text="{Binding [LspSetup.Header.Subtitle], Source={x:Static loc:Locale.Current}}"
                 FontSize="13"
                 Foreground="#888888"
                 TextWrapping="Wrap" />
    </StackPanel>

    <!-- Output log -->
    <Border Grid.Row="1"
            Background="#111111"
            CornerRadius="6"
            Padding="12">
      <ScrollViewer Name="LogScroller"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <TextBlock Text="{Binding Output}"
                   FontFamily="Courier New,Consolas,monospace"
                   FontSize="12"
                   Foreground="#CCCCCC"
                   TextWrapping="Wrap" />
      </ScrollViewer>
    </Border>

    <!-- Footer -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                  IsVisible="{Binding IsRunning}">
        <ProgressBar IsIndeterminate="True"
                     Width="160"
                     Height="4"
                     Foreground="#9D67FF" />
        <TextBlock Text="{Binding [LspSetup.Status.Installing], Source={x:Static loc:Locale.Current}}"
                   FontSize="12"
                   Foreground="#888888"
                   VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock Grid.Column="0"
                 Text="{Binding ErrorMessage}"
                 Foreground="#FF6B6B"
                 FontSize="12"
                 VerticalAlignment="Center"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 TextWrapping="Wrap" />

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding [LspSetup.Action.Retry], Source={x:Static loc:Locale.Current}}"
                Command="{Binding RetryCommand}"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="#9D67FF"
                Foreground="White"
                Padding="12,6"
                VerticalAlignment="Center" />
        <Button Content="{Binding [LspSetup.Action.Cancel], Source={x:Static loc:Locale.Current}}"
                Command="{Binding CancelCommand}"
                IsVisible="{Binding IsRunning}"
                Background="Transparent"
                Foreground="#888888"
                Padding="12,6"
                VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

  </Grid>
</UserControl>
