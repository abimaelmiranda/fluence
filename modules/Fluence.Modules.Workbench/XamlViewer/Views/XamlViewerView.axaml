<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fluence.Modules.Workbench.XamlViewer.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Fluence.Modules.Workbench.XamlViewer.Views.XamlViewerView"
             x:DataType="vm:XamlViewerViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

  <Grid RowDefinitions="*,Auto">

    <!-- Row 0: Main content area -->
    <Panel Grid.Row="0">

      <!-- Loading state -->
      <StackPanel IsVisible="{Binding IsLoading}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="12">
        <ProgressBar IsIndeterminate="True"
                     Width="120"
                     Height="3"
                     Foreground="{StaticResource FluenceBrushAccent}" />
        <TextBlock Text="Rendering preview..."
                   FontFamily="{StaticResource FluenceFontFamily}"
                   FontSize="{StaticResource FluenceFontSizeSmall}"
                   Foreground="{StaticResource FluenceBrushTextSecondary}"
                   HorizontalAlignment="Center" />
      </StackPanel>

      <!-- Error state -->
      <StackPanel IsVisible="{Binding HasError}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="8"
                  MaxWidth="480">
        <materialIcons:MaterialIcon Kind="AlertCircleOutline"
                                    Width="32"
                                    Height="32"
                                    Foreground="{StaticResource FluenceBrushTextSecondary}"
                                    HorizontalAlignment="Center" />
        <TextBlock Text="Preview unavailable"
                   FontFamily="{StaticResource FluenceFontFamily}"
                   FontSize="{StaticResource FluenceFontSizeBody}"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource FluenceBrushTextPrimary}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{Binding ErrorMessage}"
                   FontFamily="{StaticResource FluenceFontFamily}"
                   FontSize="{StaticResource FluenceFontSizeSmall}"
                   Foreground="{StaticResource FluenceBrushTextSecondary}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center" />
      </StackPanel>

      <!-- Preview content — populated via code-behind from XamlViewerViewModel.PreviewContent -->
      <ScrollViewer IsVisible="{Binding !HasError}"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
        <ContentControl x:Name="PreviewHost"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
      </ScrollViewer>

    </Panel>

    <!-- Row 1: Status bar — visible when a file is loaded -->
    <Border Grid.Row="1"
            IsVisible="{Binding SourceFileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            Background="{StaticResource FluenceBrushSurface}"
            BorderThickness="0,1,0,0"
            BorderBrush="{StaticResource FluenceBrushBorder}">
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,3">
        <TextBlock Text="{Binding SourceFileName}"
                   FontFamily="{StaticResource FluenceFontFamily}"
                   FontSize="{StaticResource FluenceFontSizeSmall}"
                   Foreground="{StaticResource FluenceBrushTextSecondary}"
                   VerticalAlignment="Center" />
        <TextBlock Text="• Hot Reload"
                   IsVisible="{Binding IsHotReloadEnabled}"
                   FontFamily="{StaticResource FluenceFontFamily}"
                   FontSize="{StaticResource FluenceFontSizeSmall}"
                   Foreground="{StaticResource FluenceBrushAccent}"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>

  </Grid>

</UserControl>
